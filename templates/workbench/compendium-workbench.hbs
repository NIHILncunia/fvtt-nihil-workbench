<div class="ncm-workbench__split ncm-workbench__split--compendium" data-workbench-layout data-workbench-pane="list">
  <div class="ncm-workbench__top">
    <div class="ncm-workbench__toolbar">
      <div class="ncm-workbench__command-group">
        <span>목록</span>
        <div class="ncm-workbench__command-buttons"><button type="button" data-action="choose"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> 선택·검색 적용</button><button type="button" data-action="refresh"><i class="fa-solid fa-rotate" aria-hidden="true"></i> 목록 새로고침</button></div>
      </div>
      {{#if canToggleLock}}
      <details class="ncm-workbench__menu" data-workbench-menu="pack">
        <summary>팩 관리 <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
        <div class="ncm-workbench__menu-panel"><button type="button" data-action="toggleLock"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{#if pack.locked}}편집 잠금 해제{{else}}편집 잠그기{{/if}}</button></div>
      </details>
      {{/if}}
      {{#if pack}}<div class="ncm-workbench__primary"><button type="button" class="ncm-workbench__save" data-action="create" {{#unless canWrite}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> 컴펜디움에 등록하고 편집</button></div>{{/if}}
    </div>
    <div class="ncm-workbench__scope"><i class="fa-solid fa-book" aria-hidden="true"></i> 컴펜디움{{#if pack}} <span aria-hidden="true">/</span> <strong>{{pack.name}}</strong> · {{#if pack.locked}}편집 잠김{{else}}편집 잠금 해제{{/if}}{{/if}}</div>
    {{#if error}}<p class="ncm-workbench__error" role="alert">{{error}}</p>{{/if}}
  </div>
  <div class="ncm-workbench__pane-switch" role="group" aria-label="워크벤치 표시 영역">
    <button type="button" data-workbench-show="list" aria-pressed="true"><i class="fa-solid fa-list" aria-hidden="true"></i> 목록</button>
    <button type="button" data-workbench-show="form" aria-pressed="false"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> 설정 폼</button>
  </div>
  <aside class="ncm-compendium-workbench__list" data-workbench-panel="list">
      <header class="ncm-workbench__list-heading"><h2>컴펜디움 목록</h2></header>
    <div class="ncm-compendium-workbench__list-tools">
      <div class="ncm-workbench__grid-2">
        <label>컨셉<select name="packConcept">{{#each concepts}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
        <label>컴펜디움<select name="packTarget">{{#each packs}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{typeLabel}}</option>{{/each}}</select></label>
      </div>
        <label>이름 검색<input type="search" name="packSearch" value="{{query}}" placeholder="컴펜디움 전체 검색"></label>
        {{#if pack}}
      <div class="ncm-workbench__header-actions"><strong>{{total}}개 항목</strong><button type="button" data-action="page" data-direction="-1" {{#unless hasPrevious}}disabled{{/unless}}>이전</button><span>{{pageLabel}}</span><button type="button" data-action="page" data-direction="1" {{#unless hasNext}}disabled{{/unless}}>다음</button></div>
        {{/if}}
  </div>
  {{#if pack}}
  <div class="ncm-compendium-workbench__entries" data-workbench-scroll="list">
    {{#each entries}}
    <button type="button" data-action="edit" data-entry-id="{{id}}" class="ncm-compendium-workbench__entry"><img src="{{img}}" alt=""><span>{{name}}</span><small>{{type}}</small></button>
    {{else}}<p class="ncm-workbench__muted">조건에 맞는 항목이 없습니다.</p>{{/each}}
  </div>
      {{/if}}
    </aside>

  <section class="ncm-compendium-workbench__content" data-workbench-scroll="form" data-workbench-panel="form">
    <p>컨셉별 모듈 팩에 직접 등록하고 편집합니다. 저장한 데이터는 이 모듈의 컴펜디움에 남습니다.</p>
      {{#if pack}}
      {{#unless canWrite}}<p class="ncm-workbench__muted">현재 팩은 조회만 가능합니다. 편집 잠금과 팩 소유 권한을 확인하십시오.</p>{{/unless}}
      <fieldset class="ncm-workbench__card">
        <legend>새 데이터 등록</legend>
        <div class="ncm-workbench__grid-2">
          <label>이름<input type="text" name="packEntryName" value="{{draft.name}}" placeholder="새 항목 이름"></label>
          <label>유형<select name="packEntryType">{{#each types}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        </div>
        <label>이미지 경로<input type="text" name="packEntryImg" value="{{draft.img}}" placeholder="modules/nihil-compendium-module/assets/..."></label>
      </fieldset>
      {{else}}<p class="ncm-workbench__notice">이 모듈에 등록된 액터·아이템 컴펜디움이 없습니다.</p>{{/if}}
    </section>
</div>
