<div class="ncm-workbench-launcher">
  <p>편집기를 각각 열거나 닫습니다.</p>
  <button type="button" data-action="openCompendiumWorkbench">컴펜디움 제작 열기</button>
  <button type="button" data-action="toggleItemWorkbench" aria-pressed="{{itemOpen}}">아이템 워크벤치 {{#if itemOpen}}닫기{{else}}열기{{/if}}</button>
  <button type="button" data-action="toggleActorWorkbench" aria-pressed="{{actorOpen}}">액터 워크벤치 {{#if actorOpen}}닫기{{else}}열기{{/if}}</button>
  <button type="button" data-action="toggleSceneWorkbench" aria-pressed="{{sceneOpen}}">씬 워크벤치 {{#if sceneOpen}}닫기{{else}}열기{{/if}}</button>
  {{#unless legacyResourceManagerActive}}<button type="button" data-action="openResourceManager">캐릭터 자원 관리 열기</button>{{/unless}}
</div>
