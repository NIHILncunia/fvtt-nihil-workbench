      {{> advancementCompoundNode this}}
    </div>
    {{else}}<p class="ncm-workbench__muted">등록된 배정이 없습니다.</p>{{/each}}
    <div class="ncm-workbench__compound-row-header">
      {{#if hasKeyOptions}}<select data-complex-new-key>{{#each keyOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select>{{else}}<input type="text" data-complex-new-key placeholder="{{keyPlaceholder}}">{{/if}}
