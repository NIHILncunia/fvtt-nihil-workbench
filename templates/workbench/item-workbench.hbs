          <div class="ncm-workbench__grid-2">
            <label>소모<input type="number" name="usesSpent" min="0" step="1" value="{{selected.uses.spent}}"></label>
            <label>최대 수식<input type="text" name="usesMax" value="{{selected.uses.max}}" placeholder="예: 3 또는 @prof"></label>
          </div>
          {{#if selected.uses.hasAutoDestroy}}<label class="ncm-workbench__toggle"><input type="checkbox" name="usesAutoDestroy" {{#if selected.uses.autoDestroy}}checked{{/if}}> 사용 횟수 소진 시 자동 삭제</label>{{/if}}
        </details>
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="uses.recovery" open>
          <summary><strong>회복 규칙</strong></summary>
          <div class="ncm-workbench__section-title"><button type="button" data-action="addRecovery"><i class="fa-solid fa-plus"></i> 회복 규칙 추가</button></div>
          <div class="ncm-workbench__recovery-list">
          {{#each selected.recoveryRows}}
          <div class="ncm-workbench__recovery-row" data-recovery-row data-index="{{index}}">
            <label>주기<select data-recovery-period>{{#each periodOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label data-recovery-type-field>회복 방식<select data-recovery-type>{{#each typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label data-recovery-formula-field>수식<input type="text" data-recovery-formula value="{{formula}}" placeholder="예: 1d4 또는 5"></label>
            <button type="button" class="icon" data-action="removeRecovery" data-index="{{index}}" title="회복 규칙 삭제"><i class="fa-solid fa-trash"></i></button>
          </div>
          {{else}}<p class="ncm-workbench__muted">회복 규칙이 없습니다.</p>{{/each}}
          </div>
        </details>

      </details>
      {{/if}}

      <details class="ncm-workbench__card ncm-workbench__collapsible ncm-workbench__on-hit" data-section-key="on-hit" open>
        <summary><strong>명중 시 효과</strong></summary>

        {{#if selected.selectedActivity}}
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="on-hit.linked" open>
          <summary><strong>연결된 효과</strong></summary>
          <div class="ncm-workbench__effect-list">
            {{#each selected.effects.onHit}}
            <div class="ncm-workbench__effect-row"><span><i class="fa-solid fa-burst"></i> {{name}}</span><button type="button" data-action="editEffect" data-effect-id="{{id}}">상세 편집</button><button type="button" data-action="detachEffect" data-effect-id="{{id}}">연결 해제</button><button type="button" data-action="deleteOnHitEffect" data-effect-id="{{id}}" class="danger">효과 삭제</button></div>
            {{else}}<p class="ncm-workbench__muted">현재 액티비티에 연결된 대상 효과가 없습니다.</p>{{/each}}
          </div>
        </details>
        {{#if selected.effects.availableTarget.length}}
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="on-hit.available" open>
          <summary><strong>기존 대상 효과 연결</strong></summary>
          <div class="ncm-workbench__chips">{{#each selected.effects.availableTarget}}<button type="button" data-action="attachEffect" data-effect-id="{{id}}" class="ncm-workbench__chip">{{name}}</button>{{/each}}</div>
        </details>
        {{/if}}
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="on-hit.create" open>
          <summary><strong>새 상태 효과 추가</strong></summary>
          <div class="ncm-workbench__inline-form">
            <input type="text" name="onHitName" placeholder="효과 이름 (선택)">
            <select name="onHitStatus"><option value="">상태 선택</option>{{#each statusOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
            <input type="number" name="onHitRounds" min="0" value="1" title="라운드">
            <button type="button" data-action="addOnHitStatus"><i class="fa-solid fa-plus"></i> 상태 효과 추가</button>
          </div>
        </details>
        {{else}}<p class="ncm-workbench__muted">명중 시 효과를 사용하려면 액티비티가 필요합니다.</p>{{/if}}

      </details>

      <details class="ncm-workbench__card ncm-workbench__collapsible" data-section-key="passive" open>
        <summary><strong>지속 효과</strong></summary>

        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="effects.all" open>
          <summary><strong>모든 아이템 효과 관리</strong></summary>
          <button type="button" data-action="createEffect">빈 효과 추가·편집</button>
          {{#each managedEffects}}
          <div class="ncm-workbench__effect-row"><span>{{name}} <small>{{#if transfer}}전이{{else}}대상{{/if}} · {{#if disabled}}비활성{{else}}활성{{/if}}</small></span>
            <button type="button" data-action="editEffect" data-effect-id="{{id}}">상세 편집</button>
            <button type="button" data-action="toggleEffect" data-effect-id="{{id}}">{{#if disabled}}활성화{{else}}비활성화{{/if}}</button>
            <button type="button" data-action="duplicateEffect" data-effect-id="{{id}}">복제</button>
            <button type="button" data-action="deleteEffect" data-effect-id="{{id}}">삭제</button>
          </div>
          {{else}}<p>아이템 효과가 없습니다.</p>{{/each}}
        </details>

        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="passive.list" open>
          <summary><strong>지속 효과 목록</strong></summary>
          <div class="ncm-workbench__effect-list">
            {{#each selected.effects.passive}}
            <div class="ncm-workbench__effect-row"><span><i class="fa-solid fa-shield-halved"></i> {{name}}</span><small>{{#each changes}}{{key}} {{value}}{{/each}}</small></div>
            {{else}}<p class="ncm-workbench__muted">전이형 지속 효과가 없습니다.</p>{{/each}}
          </div>
        </details>
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="passive.create" open>
          <summary><strong>새 지속 효과 추가</strong></summary>
          <div class="ncm-workbench__passive-form">
            <input type="text" name="passiveName" placeholder="효과 이름">
            <input type="text" name="passiveKey" placeholder="예: system.attributes.ac.bonus">
            <select name="passiveMode">{{#each effectModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            <input type="text" name="passiveValue" placeholder="값">
            <button type="button" data-action="addPassiveEffect"><i class="fa-solid fa-plus"></i> 지속 효과 추가</button>
          </div>
        </details>

      </details>
    </div>

    <footer class="ncm-workbench__footer">
      <span class="ncm-workbench__muted">입력 보관은 현재 창 안에서 유지됩니다. 브라우저 새로고침 전에는 변경사항을 저장하십시오.</span>
    </footer>
    {{else}}
    {{#if missingTargetDraft}}
    <div class="ncm-workbench__notice"><h2>삭제된 아이템의 보관 입력</h2>
      <p>대상이 삭제되어 저장할 수 없습니다. 필요한 값을 복사한 뒤 아이템 전환 시 입력 버리기를 선택하십시오. 브라우저 새로고침 전에는 복사하십시오.</p>
      {{#each missingTargetDraft}}<label>{{name}}<textarea readonly data-workbench-transient>{{value}}</textarea></label>{{/each}}
    </div>
    {{else}}<div class="ncm-workbench__empty"><i class="fa-solid fa-hammer"></i><h2>아이템을 선택하십시오.</h2></div>{{/if}}
    {{/if}}
  </section>
</div>
