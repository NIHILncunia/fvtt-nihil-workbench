      <div class="ncm-workbench__compound-row-header"><strong>항목 {{ordinal}}</strong><button type="button" data-action="removeAdvancementEntry" data-complex-list-address="{{address}}" data-complex-index="{{index}}"><i class="fa-solid fa-trash"></i> 삭제</button></div>
      {{> advancementCompoundNode node}}
    </div>
    {{else}}<p class="ncm-workbench__muted">등록된 항목이 없습니다.</p>{{/each}}
    <button type="button" data-action="addAdvancementEntry" data-complex-list-address="{{address}}"><i class="fa-solid fa-plus"></i> 항목 추가</button>
  </div>
  {{/if}}
  {{#if isObject}}
  <div class="ncm-workbench__compound-grid">
    {{#each children}}{{> advancementCompoundNode this}}{{/each}}
  </div>
  {{/if}}
  {{#if isLeaf}}
  <label class="ncm-workbench__type-field">
    <span>{{label}}</span>
    {{#if hasChoices}}
    <select data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    {{else}}
      {{#if isBoolean}}<input type="checkbox" data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}" {{#if value}}checked{{/if}}>{{/if}}
      {{#if isNumber}}<input type="number" step="{{step}}" {{#if hasMin}}min="{{min}}"{{/if}} {{#if hasMax}}max="{{max}}"{{/if}} data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}" value="{{value}}">{{/if}}
      {{#if isText}}<input type="text" {{#if isReference}}list="{{referenceList}}"{{/if}} data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}" value="{{value}}" {{#if readOnly}}readonly{{/if}}>{{/if}}
    {{/if}}
    {{#if isReference}}<datalist id="{{referenceList}}">{{#each options}}<option value="{{value}}">{{label}}</option>{{/each}}</datalist><small>목록에서 선택하거나 다른 문서의 참조 값을 입력합니다.</small>{{/if}}
    {{#if help}}<small>{{help}}</small>{{/if}}
  </label>
  {{/if}}
{{/inline}}
{{#*inline "typeCompoundNode"}}
  {{#if isList}}
  <div class="ncm-workbench__compound-list">
    {{#each rows}}
    <div class="ncm-workbench__compound-row">
      <div class="ncm-workbench__compound-row-header"><strong>항목 {{ordinal}}</strong><button type="button" data-action="removeTypeEntry" data-complex-list-address="{{address}}" data-complex-index="{{index}}"><i class="fa-solid fa-trash"></i> 삭제</button></div>
      {{> typeCompoundNode node}}
    </div>
    {{else}}<p class="ncm-workbench__muted">등록된 항목이 없습니다.</p>{{/each}}
    <button type="button" data-action="addTypeEntry" data-complex-list-address="{{address}}"><i class="fa-solid fa-plus"></i> 항목 추가</button>
  </div>
  {{/if}}
  {{#if isObject}}
  <div class="ncm-workbench__compound-grid">
    {{#each children}}{{> typeCompoundNode this}}{{/each}}
  </div>
  {{/if}}
  {{#if isLeaf}}
  <label class="ncm-workbench__type-field">
    <span>{{label}}</span>
    {{#if hasChoices}}
    <select data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    {{else}}
      {{#if isBoolean}}<input type="checkbox" data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}" {{#if value}}checked{{/if}}>{{/if}}
      {{#if isNumber}}<input type="number" step="{{step}}" {{#if hasMin}}min="{{min}}"{{/if}} {{#if hasMax}}max="{{max}}"{{/if}} data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}" value="{{value}}">{{/if}}
      {{#if isText}}<input type="text" {{#if isReference}}list="{{referenceList}}"{{/if}} data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}" value="{{value}}" {{#if readOnly}}readonly{{/if}}>{{/if}}
    {{/if}}
    {{#if isReference}}<datalist id="{{referenceList}}">{{#each options}}<option value="{{value}}">{{label}}</option>{{/each}}</datalist><small>목록에서 선택하거나 다른 문서의 참조 값을 입력합니다.</small>{{/if}}
  </label>
  {{/if}}
{{/inline}}
{{#*inline "folderCrumb"}}
<button type="button" data-action="goBreadcrumb" data-folder-id="{{id}}" class="ncm-workbench__breadcrumb{{#if current}} is-current{{/if}}" {{#if current}}aria-current="location"{{/if}}>{{name}}</button>
{{/inline}}
{{#*inline "folderCommands"}}
<button type="button" data-action="createFolder"><i class="fa-solid fa-folder-plus" aria-hidden="true"></i> 폴더 생성</button><button type="button" data-action="editFolder" {{#unless currentFolder}}disabled{{/unless}}><i class="fa-solid fa-folder-open" aria-hidden="true"></i> 폴더 편집</button><button type="button" data-action="deleteFolder" {{#unless currentFolder}}disabled{{/unless}}><i class="fa-solid fa-folder-minus" aria-hidden="true"></i> 폴더 삭제</button>
{{/inline}}
{{#*inline "itemCommands"}}
<button type="button" data-action="duplicateItem" {{#unless selected}}disabled{{/unless}}><i class="fa-solid fa-copy" aria-hidden="true"></i> 아이템 복제</button><button type="button" data-action="deleteItem" {{#unless selected}}disabled{{/unless}}><i class="fa-solid fa-trash" aria-hidden="true"></i> 아이템 삭제</button>
{{/inline}}
<div class="ncm-workbench__split ncm-workbench__split--item" data-workbench-layout data-workbench-pane="list">
  <div class="ncm-workbench__top">
    <div class="ncm-workbench__toolbar">
      {{#if canManageItems}}{{#unless isEmbeddedItem}}
      <div class="ncm-workbench__command-group ncm-workbench__wide">
        <span>폴더</span>
        <div class="ncm-workbench__command-buttons">{{> folderCommands}}</div>
      </div>
      <details class="ncm-workbench__menu ncm-workbench__compact" data-workbench-menu="folders">
        <summary>폴더 <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
        <div class="ncm-workbench__menu-panel">
          {{> folderCommands}}
        </div>
      </details>
      {{/unless}}
      <div class="ncm-workbench__command-group">
        <span>항목</span>
        <div class="ncm-workbench__command-buttons"><button type="button" data-action="createItem"><i class="fa-solid fa-plus"></i> 아이템 생성</button><div class="ncm-workbench__command-buttons ncm-workbench__wide">{{> itemCommands}}</div></div>
      </div>
      {{/if}}
      {{#if selected}}<details class="ncm-workbench__menu" data-workbench-menu="selection">
        <summary>선택 항목 <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
        <div class="ncm-workbench__menu-panel">
          {{#if canManageItems}}<div class="ncm-workbench__command-stack ncm-workbench__compact">{{> itemCommands}}</div>{{/if}}{{#if selected}}{{#if isEmbeddedItem}}<span class="ncm-workbench__muted">권한: 소유 액터에서 상속</span>{{else}}{{#if packTarget}}<span class="ncm-workbench__muted">권한: 컴펜디움에서 상속</span>{{else}}<button type="button" data-action="editOwnership"><i class="fa-solid fa-user-shield" aria-hidden="true"></i> 사용자 권한</button>{{/if}}{{/if}}<button type="button" data-action="openAdvanced" class="ncm-workbench__advanced"><i class="fa-solid fa-arrow-up-right-from-square"></i> 전체 아이템 설정</button>{{/if}}
        </div>
      </details>{{/if}}
      <div class="ncm-workbench__primary">{{#if selected}}<button type="submit" class="ncm-workbench__save" {{#unless canManageItems}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk"></i> 변경사항 저장</button>{{else}}<button type="submit" disabled class="ncm-workbench__save"><i class="fa-solid fa-floppy-disk"></i> 변경사항 저장</button>{{/if}}</div>
    </div>
    {{#unless isEmbeddedItem}}
    <nav class="ncm-workbench__path" aria-label="아이템 폴더 경로">
      <button type="button" class="ncm-workbench__folder-up icon" data-action="goParentFolder" title="상위 폴더" aria-label="상위 폴더" {{#unless canGoParent}}disabled{{/unless}}><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
      <div class="ncm-workbench__path-parts">
        <button type="button" data-action="goBreadcrumb" data-folder-id="" class="ncm-workbench__breadcrumb{{#unless canGoParent}} is-current{{/unless}}" {{#unless canGoParent}}aria-current="location"{{/unless}}><i class="fa-solid fa-star" aria-hidden="true"></i> 루트</button>
        {{#if path.middle.length}}
        <div class="ncm-workbench__path-segment ncm-workbench__wide"><span aria-hidden="true">/</span>
          <details class="ncm-workbench__menu ncm-workbench__path-menu" data-workbench-menu="path-wide">
            <summary>상위 {{path.middle.length}}개 <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
            <div class="ncm-workbench__menu-panel">
              {{#each path.middle}}
                {{> folderCrumb}}
              {{/each}}
            </div>
          </details>
        </div>
        {{/if}}
        {{#if path.ancestors.length}}
        <div class="ncm-workbench__path-segment ncm-workbench__compact"><span aria-hidden="true">/</span>
          <details class="ncm-workbench__menu ncm-workbench__path-menu" data-workbench-menu="path-narrow">
            <summary>상위 {{path.ancestors.length}}개 <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
            <div class="ncm-workbench__menu-panel">
              {{#each path.ancestors}}
                {{> folderCrumb}}
              {{/each}}
            </div>
          </details>
        </div>
        {{/if}}
        {{#with path.parent}}
        <div class="ncm-workbench__path-segment ncm-workbench__wide"><span aria-hidden="true">/</span>{{> folderCrumb}}</div>
        {{/with}}
        {{#with path.current}}
        <div class="ncm-workbench__path-segment"><span aria-hidden="true">/</span>{{> folderCrumb}}</div>
        {{/with}}
      </div>
    </nav>
    {{else}}
    <div class="ncm-workbench__scope"><i class="fa-solid fa-user" aria-hidden="true"></i> 액터 소유 아이템</div>
    {{/unless}}
  </div>
  <div class="ncm-workbench__pane-switch" role="group" aria-label="워크벤치 표시 영역">
    <button type="button" data-workbench-show="list" aria-pressed="true"><i class="fa-solid fa-list" aria-hidden="true"></i> 목록</button>
    <button type="button" data-workbench-show="form" aria-pressed="false"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> 설정 폼</button>
  </div>
  <aside class="ncm-workbench__browser" data-workbench-panel="list">
    <header class="ncm-workbench__list-heading"><div class="ncm-workbench__heading-text">{{#if packTarget}}<p class="ncm-workbench__notice">컴펜디움 직접 편집: <strong>{{packTarget.label}}</strong> · {{#if packTarget.locked}}편집 잠김{{else}}변경 사항은 모듈 팩에 저장됩니다{{/if}}</p>{{/if}}<div class="ncm-workbench__eyebrow">{{#if isEmbeddedItem}}액터 소유 아이템{{else}}{{#if packTarget}}컴펜디움 아이템{{else}}월드 아이템{{/if}}{{/if}}</div><h2>아이템 탐색기</h2></div><span class="ncm-workbench__count">{{browserItemCount}}</span></header>
    <div class="ncm-workbench__filters">
      <input type="search" name="browserSearch" placeholder="이름·타입·폴더 검색" aria-label="이름·타입·폴더 검색" data-workbench-transient>
      <select name="browserType" aria-label="아이템 타입" data-workbench-transient><option value="">모든 타입</option>{{#each itemTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
    </div>
    <div class="ncm-workbench__item-list" data-workbench-scroll="list">
      {{#each folders}}
      <button type="button" data-action="openFolder" data-folder-id="{{id}}" data-browser-folder data-search="{{searchText}}" class="ncm-workbench__folder-row">
        <span class="ncm-workbench__folder-icon"><i class="fa-solid fa-folder"></i></span><span class="name">{{name}}</span><i class="fa-solid fa-chevron-right"></i>
      </button>
      {{/each}}
      {{#each items}}
      <button type="button" data-action="selectItem" data-item-id="{{id}}" data-browser-item data-search="{{searchText}}" data-item-type="{{type}}" class="ncm-workbench__item-row {{#if selected}}is-selected{{/if}}">
        <img src="{{img}}" alt=""><span class="name">{{name}}<small>{{typeLabel}}</small></span><i class="fa-solid fa-chevron-left"></i>
      </button>
      {{/each}}
      {{#unless folders.length}}{{#unless items.length}}<div class="ncm-workbench__folder-empty">이 폴더는 비어 있습니다.</div>{{/unless}}{{/unless}}
    </div>
  </aside>

  <section class="ncm-workbench__editor" data-workbench-panel="form">
    {{#if selected}}
    <header class="ncm-workbench__item-header">
      <img src="{{selected.img}}" alt="" class="ncm-workbench__item-icon">
      <div class="ncm-workbench__heading-text">
        <div class="ncm-workbench__eyebrow">아이템 편집기 · {{selected.typeLabel}}</div>
        <h2>{{selected.name}}</h2>
      </div>
      <div class="ncm-workbench__header-actions">
        {{#if isEmbeddedItem}}<button type="button" data-action="returnToActor"><i class="fa-solid fa-user"></i> 액터로 돌아가기</button>{{/if}}
        <button type="button" data-action="expandAllSections" title="전체 펼치기"><i class="fa-solid fa-angles-down"></i> 전체 펼치기</button>
        <button type="button" data-action="collapseAllSections" title="전체 접기"><i class="fa-solid fa-angles-up"></i> 전체 접기</button>
      </div>
    </header>

    <div class="ncm-workbench__scroll" data-workbench-scroll="form">
      <details class="ncm-workbench__card ncm-workbench__collapsible" data-section-key="basic" open>
        <summary><strong>기본 정보</strong></summary>

        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="basic.identity" open>
          <summary><strong>식별 정보</strong></summary>
          <div class="ncm-workbench__grid-2">
            <label>이름<input type="text" name="itemName" value="{{selected.name}}"></label>
            <label>아이콘 경로<input type="text" name="itemImg" value="{{selected.img}}"><button type="button" data-action="pickItemImage">이미지 선택</button></label>
            <label>식별자<input type="text" name="identifier" value="{{selected.identifier}}"></label>
          </div>
        </details>
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="basic.source" open>
          <summary><strong>출처</strong></summary>
          <div class="ncm-workbench__grid-4">
            <label>출처 책<input type="text" name="sourceBook" value="{{selected.source.book}}"></label>
            <label>출처 페이지<input type="text" name="sourcePage" value="{{selected.source.page}}"></label>
            <label>사용자 출처<input type="text" name="sourceCustom" value="{{selected.source.custom}}"></label>
            <label>라이선스<input type="text" name="sourceLicense" value="{{selected.source.license}}"></label>
            <label>규칙<select name="sourceRules">{{#each selected.sourceRuleOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label>리비전<input type="number" name="sourceRevision" min="1" step="1" value="{{selected.source.revision}}"></label>
          </div>
        </details>
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="basic.description" open>
          <summary><strong>설명</strong></summary>
          <label>설명<textarea name="description" rows="5">{{selected.description}}</textarea></label>
        </details>

      </details>

      <details class="ncm-workbench__card ncm-workbench__collapsible ncm-workbench__activity-workspace" data-section-key="activities.workspace" open>
        <summary><strong>액티비티 작업 영역</strong> <span>생성 · 수정 · 삭제</span></summary>

        {{#if selected.activityWorkspaceNewTypeOptions.length}}
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="activities.create" open>
          <summary><strong>새 액티비티</strong></summary>
          <div class="ncm-workbench__activity-create">
            <select name="activityWorkspaceNewType">{{#each selected.activityWorkspaceNewTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            <p class="ncm-workbench__muted">유형을 고른 뒤 아래와 같은 작성 폼에서 내용을 입력합니다.</p>
            <button type="button" data-action="newActivityWorkspace"><i class="fa-solid fa-plus"></i> 새 액티비티 작성</button>
          </div>
        </details>
        {{/if}}

        {{#if selected.activityWorkspace.isCreate}}
        <section class="ncm-workbench__activity-new-editor">
          <h3>새 액티비티 작성 · {{selected.activityWorkspace.typeLabel}}</h3>
          {{> activityEditor @root}}
        </section>
        {{/if}}
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="activities.list" open>
          <summary><strong>액티비티 목록</strong></summary>
          <div class="ncm-workbench__activity-list">
            {{#each selected.activities}}
            <section class="ncm-workbench__activity-entry {{#if expanded}}is-expanded{{/if}}">
              <div class="ncm-workbench__activity-row {{#if selected}}is-selected{{/if}}">
                <button type="button" data-action="selectActivity" data-activity-id="{{id}}" class="ncm-workbench__activity-select" aria-expanded="{{expanded}}" aria-controls="ncm-activity-entry-{{id}}">
                  <i class="fa-solid {{#if expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}" aria-hidden="true"></i>
                  <span>{{#if name}}{{name}}{{else}}(기본 액티비티){{/if}}</span><small>{{typeLabel}}</small>
                </button>
                <button type="button" class="icon" data-action="moveActivity" data-activity-id="{{id}}" data-direction="-1" aria-label="{{name}} 위로 이동" {{#unless canMoveUp}}disabled{{/unless}}><i class="fa-solid fa-arrow-up"></i></button>
                <button type="button" class="icon" data-action="moveActivity" data-activity-id="{{id}}" data-direction="1" aria-label="{{name}} 아래로 이동" {{#unless canMoveDown}}disabled{{/unless}}><i class="fa-solid fa-arrow-down"></i></button>
              </div>
              <div id="ncm-activity-entry-{{id}}" {{#unless expanded}}hidden{{/unless}}>
                {{#if selected}}{{#unless @root.selected.activityWorkspace.isCreate}}{{> activityEditor @root}}{{/unless}}{{/if}}
              </div>
            </section>
            {{else}}<p class="ncm-workbench__muted">액티비티가 없습니다. 위에서 유형을 골라 작성하십시오.</p>{{/each}}
          </div>
        </details>
      </details>

      {{#if selected.hasTypeFields}}
      <details class="ncm-workbench__card ncm-workbench__collapsible ncm-workbench__type-fields" data-section-key="type" open>
        <summary><strong>{{selected.typeLabel}} 전용 설정</strong> <span>유형별 설정</span></summary>
        {{#each selected.typeFieldGroups}}
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="type.{{key}}" open>
          <summary><strong>{{label}}</strong></summary>
          <div class="ncm-workbench__type-field-grid">
            {{#each fields}}
            {{> typeField this}}
            {{/each}}
          </div>
        </details>
        {{/each}}
      </details>
      {{/if}}

      {{#if selected.hasProperties}}
      <details class="ncm-workbench__card ncm-workbench__collapsible" data-section-key="properties" open>
        <summary><strong>속성</strong></summary>

        <div class="ncm-workbench__property-grid">
          {{#each selected.propertyOptions}}
          <label class="ncm-workbench__property-option {{#if legacy}}is-legacy{{/if}}">
            <input type="checkbox" name="properties" value="{{value}}" {{#if selected}}checked{{/if}}>
            <span>{{label}}</span>{{#if legacy}}<small>기존/확장</small>{{/if}}
          </label>
          {{/each}}
        </div>

      </details>
      {{/if}}

      {{#if selected.hasEquipAttunement}}
      <details class="ncm-workbench__card ncm-workbench__collapsible" data-section-key="equip" open>
        <summary><strong>장착 / 조율</strong></summary>

        <div class="ncm-workbench__grid-2">
          <label class="ncm-workbench__toggle"><input type="checkbox" name="equipped" {{#if selected.equipAttunement.equipped}}checked{{/if}}> 장착됨</label>
          <label>조율 요구<select name="attunement">{{#each selected.attunementOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label class="ncm-workbench__toggle"><input type="checkbox" name="attuned" {{#if selected.equipAttunement.attuned}}checked{{/if}}> 현재 조율됨</label>
        </div>

      </details>
      {{/if}}

      {{#if selected.hasInventory}}
      <details class="ncm-workbench__card ncm-workbench__collapsible" data-section-key="inventory" open>
        <summary><strong>인벤토리 / 경제</strong></summary>

        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="inventory.stock" open>
          <summary><strong>수량 / 희귀도</strong></summary>
          <div class="ncm-workbench__grid-2">
            <label>수량<input type="number" name="quantity" min="0" step="1" value="{{selected.inventory.quantity}}"></label>
            <label>희귀도<select name="rarity">{{#each selected.rarityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          </div>
        </details>
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="inventory.physical" open>
          <summary><strong>물리 정보</strong></summary>
          <div class="ncm-workbench__grid-2">
            <label>무게<input type="number" name="weightValue" min="0" step="any" value="{{selected.inventory.weight.value}}"></label>
            <label>무게 단위<select name="weightUnits">{{#each selected.weightUnitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          </div>
        </details>
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="inventory.economy" open>
          <summary><strong>경제 정보</strong></summary>
          <div class="ncm-workbench__grid-2">
            <label>가격<input type="number" name="priceValue" min="0" step="any" value="{{selected.inventory.price.value}}"></label>
            <label>화폐<select name="priceDenomination">{{#each selected.currencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          </div>
        </details>
        <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="inventory.container" open>
          <summary><strong>보관용품</strong></summary>
          <label>보관용품<select name="containerId">{{#each selected.containerOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        </details>

      </details>
      {{/if}}

      {{#if selected.containerManagement}}
      <details class="ncm-workbench__card ncm-workbench__collapsible" data-section-key="container" open>
        <summary><strong>보관 항목 관리</strong> <span>직접 보관 {{selected.containerManagement.directCount}}종</span></summary>
        <nav class="ncm-workbench__container-path" aria-label="보관용품 경로">
          <span>{{#if isEmbeddedItem}}액터 소유 아이템{{else}}{{#if packTarget}}컴펜디움 아이템{{else}}월드 아이템{{/if}}{{/if}}</span>
          {{#each selected.containerManagement.ancestors}}<span>/</span><button type="button" data-action="openContainerItem" data-item-id="{{id}}">{{name}}</button>{{/each}}
