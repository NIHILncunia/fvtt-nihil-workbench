{{#*inline "typeField"}}
            {{#if isComplex}}
            <div class="ncm-workbench__field-wide ncm-workbench__compound" data-type-complex-root>
              <strong>{{label}}</strong>
              <input type="hidden" data-type-field data-type-path="{{path}}" data-type-kind="complex" value="{{value}}">
              {{> typeCompoundNode editor}}
            </div>
            {{else}}
            <label class="ncm-workbench__type-field {{#if isJson}}is-json{{/if}}">
              <span>{{label}}</span>
              {{#if hasChoices}}<select data-type-field data-type-path="{{path}}" data-type-kind="{{kind}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}
              {{#if isBoolean}}<input type="checkbox" data-type-field data-type-path="{{path}}" data-type-kind="{{kind}}" {{#if value}}checked{{/if}}>{{/if}}
              {{#if isNumber}}<input type="number" step="any" data-type-field data-type-path="{{path}}" data-type-kind="{{kind}}" value="{{value}}">{{/if}}
              {{#if isText}}<input type="text" data-type-field data-type-path="{{path}}" data-type-kind="{{kind}}" value="{{value}}">{{/if}}
              {{#if isJson}}<textarea rows="3" data-type-field data-type-path="{{path}}" data-type-kind="{{kind}}">{{value}}</textarea>{{/if}}
              {{/if}}
              <small>{{path}}</small>
            </label>
            {{/if}}
{{/inline}}
{{#*inline "activityEditor"}}
<div class="ncm-workbench__activity-editor" data-activity-editor>
  {{#if selected.activityWorkspace.isSystemManaged}}
  <p class="ncm-workbench__notice">시설 명령 액티비티는 시스템이 자동 생성하고 관리합니다. 시설 본체에서 건설·명령·제작 설정을 수정하십시오.</p>
  {{else}}
  {{#if selected.activityWorkspace.isNative}}
  <div class="ncm-workbench__activity-workspace-actions">
    {{#if selected.activityWorkspace.isCreate}}<button type="button" data-action="cancelActivityWorkspace"><i class="fa-solid fa-xmark"></i> 작성 취소</button>{{else}}
    <button type="button" data-action="duplicateActivity"><i class="fa-regular fa-copy"></i> 복제</button>
    <button type="button" data-action="openActivityAdvanced">워크벤치 전체 액티비티 설정</button>
    <button type="button" data-action="deleteActivity" class="danger"><i class="fa-solid fa-trash"></i> 삭제</button>{{/if}}
    <button type="button" data-action="saveActivityWorkspace" class="ncm-workbench__save"><i class="fa-solid fa-floppy-disk"></i> 액티비티 저장</button>
  </div>
  <nav class="ncm-workbench__activity-tabs" role="tablist" aria-label="액티비티 편집">
    {{#each selected.activityTabs}}<button type="button" role="tab" data-action="selectActivityTab" data-activity-tab="{{id}}" aria-selected="{{active}}" aria-controls="ncm-activity-panel-{{id}}" id="ncm-activity-tab-{{id}}" {{#if active}}class="is-active"{{/if}}>{{label}}</button>{{/each}}
  </nav>
  {{#each selected.activityTabs}}
  <section role="tabpanel" id="ncm-activity-panel-{{id}}" aria-labelledby="ncm-activity-tab-{{id}}" data-activity-panel="{{id}}" {{#unless active}}hidden{{/unless}}>
    {{#if isIdentity}}
            <div class="ncm-workbench__grid-2">
              <label>이름<input type="text" name="activityWorkspaceName" value="{{@root.selected.activityWorkspace.name}}" placeholder="예: Midi Damage"></label>
              <label>액티비티 유형<select disabled>{{#each @root.selected.activityWorkspace.typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            </div>

    {{/if}}
    {{#if isActivation}}
            <fieldset class="ncm-workbench__activity-workspace-group">
              <legend>발동</legend>
              <div class="ncm-workbench__grid-4">
                <label>발동 방식<select name="activityWorkspaceActivationType">{{#each @root.selected.activityWorkspace.activationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label>수치<input type="number" name="activityWorkspaceActivationValue" min="0" step="1" value="{{@root.selected.activityWorkspace.activation.value}}"></label>
                <label class="ncm-workbench__activity-workspace-span-2">조건<input type="text" name="activityWorkspaceActivationCondition" value="{{@root.selected.activityWorkspace.activation.condition}}"></label>
              </div>
            </fieldset>

            <fieldset class="ncm-workbench__activity-workspace-group">
              <legend>사용 횟수와 회복</legend>
              <div class="ncm-workbench__grid-2">
                <label>소모 횟수<input type="number" name="activityWorkspaceUsesSpent" min="0" step="1" value="{{@root.selected.activityWorkspace.uses.spent}}"></label>
                <label>최대 사용 횟수<input type="text" name="activityWorkspaceUsesMax" value="{{@root.selected.activityWorkspace.uses.max}}" placeholder="예: 3 또는 @prof"></label>
              </div>
              <div class="ncm-workbench__recovery-list">
                {{#each @root.selected.activityWorkspace.recoveryRows}}
                <div class="ncm-workbench__recovery-row" data-activity-workspace-recovery-row>
                  <label>회복 시점<select data-activity-workspace-recovery-period>{{#each periodOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label>회복 방식<select data-activity-workspace-recovery-type>{{#each typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label>회복식<input type="text" data-activity-workspace-recovery-formula value="{{formula}}" placeholder="수식 회복 또는 재충전"></label>
                  <button type="button" class="icon danger" data-action="removeActivityWorkspaceRecovery" data-activity-workspace-recovery-index="{{index}}"><i class="fa-solid fa-trash"></i></button>
                </div>
                {{/each}}
              </div>
              <button type="button" data-action="addActivityWorkspaceRecovery"><i class="fa-solid fa-plus"></i> 회복 규칙 추가</button>
            </fieldset>

    {{/if}}
    {{#if isTargets}}
            <fieldset class="ncm-workbench__activity-workspace-group">
              <legend>사거리 · 대상 · 범위</legend>
              <div class="ncm-workbench__grid-4">
                <label>사거리<input type="text" name="activityWorkspaceRangeValue" value="{{@root.selected.activityWorkspace.range.value}}" placeholder="예: 60"></label>
                <label>사거리 단위<select name="activityWorkspaceRangeUnits">{{#each @root.selected.activityWorkspace.rangeUnitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="ncm-workbench__activity-workspace-span-2">특수 사거리<input type="text" name="activityWorkspaceRangeSpecial" value="{{@root.selected.activityWorkspace.range.special}}"></label>
                <label>대상<select name="activityWorkspaceTargetType">{{#each @root.selected.activityWorkspace.targetOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label>대상 수<input type="text" name="activityWorkspaceTargetCount" value="{{@root.selected.activityWorkspace.target.count}}" placeholder="예: 1"></label>
                <label class="ncm-workbench__activity-workspace-span-2">특수 대상<input type="text" name="activityWorkspaceTargetSpecial" value="{{@root.selected.activityWorkspace.target.special}}"></label>
                <label>범위 형태<select name="activityWorkspaceTemplateType">{{#each @root.selected.activityWorkspace.templateOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label>범위 크기<input type="text" name="activityWorkspaceTemplateSize" value="{{@root.selected.activityWorkspace.target.template.size}}" placeholder="예: 10"></label>
                <label>범위 단위<select name="activityWorkspaceTemplateUnits">{{#each @root.selected.activityWorkspace.templateUnitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              </div>
            </fieldset>

    {{/if}}
    {{#if isType}}
            {{#if @root.selected.activityWorkspace.supportsDamage}}
            <fieldset class="ncm-workbench__activity-workspace-group">
              <legend>피해</legend>
              {{#each @root.selected.activityWorkspace.damageRows}}
              <div class="ncm-workbench__damage-row" data-activity-workspace-damage-row>
                <label>피해 주사위식<input type="text" data-activity-workspace-damage-formula value="{{formula}}" placeholder="예: 2d6 + 1"></label>
                <button type="button" class="icon danger" data-action="removeActivityWorkspaceDamage" data-activity-workspace-damage-index="{{index}}"><i class="fa-solid fa-trash"></i></button>
                <div class="ncm-workbench__damage-type-grid">
                  {{#each damageTypes}}
                  <button type="button" class="ncm-workbench__damage-type-option" data-action="toggleDamageType" data-activity-workspace-damage-type data-damage-type="{{value}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">
                    <span class="ncm-workbench__check-icon" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                    {{#if icon}}<dnd5e-icon src="{{icon}}"></dnd5e-icon>{{else}}<i class="fa-solid fa-burst"></i>{{/if}}
                    <span class="ncm-workbench__damage-type-label">{{label}}</span>
                  </button>
                  {{/each}}
                </div>
              </div>
              {{/each}}
              <button type="button" data-action="addActivityWorkspaceDamage"><i class="fa-solid fa-plus"></i> 피해 행 추가</button>
            </fieldset>
            {{/if}}

            {{#if @root.selected.activityWorkspace.supportsHealing}}
            <fieldset class="ncm-workbench__activity-workspace-group">
              <legend>회복</legend>
              <label>회복 주사위식<input type="text" name="activityWorkspaceHealingFormula" value="{{@root.selected.activityWorkspace.healing.formula}}" placeholder="예: 2d8 + 3"></label>
              <div class="ncm-workbench__property-grid">
                {{#each @root.selected.activityWorkspace.healingTypes}}
                <label class="ncm-workbench__property-option"><input type="checkbox" name="activityWorkspaceHealingTypes" value="{{value}}" {{#if selected}}checked{{/if}}> {{label}}</label>
                {{/each}}
              </div>
            </fieldset>
            {{/if}}

            {{#if @root.selected.activityWorkspace.isAttack}}
            <fieldset class="ncm-workbench__activity-workspace-group">
              <legend>공격</legend>
              <div class="ncm-workbench__grid-2">
                <label>사용 능력치<select name="activityWorkspaceAttackAbility">{{#each @root.selected.activityWorkspace.attackAbilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label>공격 보너스<input type="text" name="activityWorkspaceAttackBonus" value="{{@root.selected.activityWorkspace.attack.bonus}}"></label>
              </div>
            </fieldset>
            {{/if}}

            {{#if @root.selected.activityWorkspace.isSave}}
            <fieldset class="ncm-workbench__activity-workspace-group">
              <legend>내성 굴림</legend>
              <div class="ncm-workbench__grid-2">
                <label>내성 능력치 (여러 개 선택)<select name="activityWorkspaceSaveAbilities" multiple size="3">{{#each @root.selected.activityWorkspace.saveAbilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label>내성 난이도<input type="text" name="activityWorkspaceSaveDc" value="{{@root.selected.activityWorkspace.save.dc}}" placeholder="예: 17"></label>
                <label>계산 방식<input type="text" name="activityWorkspaceSaveCalculation" value="{{@root.selected.activityWorkspace.save.calculation}}"></label>
                <label>성공 시 피해<select name="activityWorkspaceSaveOnSave">{{#each @root.selected.activityWorkspace.saveOnSaveOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              </div>
            </fieldset>
            {{/if}}

    {{/if}}
    {{#each groups}}
    <details class="ncm-workbench__activity-tab-group ncm-workbench__collapsible" data-section-key="activities.tab.{{../id}}.{{key}}" open>
      <summary><strong>{{label}}</strong></summary>
      <div class="ncm-workbench__type-field-grid">{{#each fields}}{{> activityField this}}{{/each}}</div>
    </details>
    {{/each}}
  </section>
  {{/each}}

  {{else}}
  {{#if selected.isExternalActivity}}
  <div class="ncm-workbench__activity-external">
    <strong>외부 액티비티 <span>{{selected.selectedActivity.type}}</span></strong>
    <p class="ncm-workbench__muted">공통 설정은 아래에서 수정합니다. 모듈 고유 설정을 확인하는 내부 전체 설정은 전용 일반 폼과 지원 범위가 다릅니다.</p>
    <button type="button" data-action="openActivityAdvanced">워크벤치 전체 액티비티 설정</button>
    <details class="ncm-workbench__collapsible" data-section-key="activities.external.source">
      <summary>원본 데이터 확인</summary>
      <textarea class="ncm-workbench__raw-source" rows="8" readonly>{{selected.externalActivitySource}}</textarea>
    </details>
    {{#if selected.hasActivityCommonFields}}
    {{#each selected.activityCommonFieldGroups}}
    <details class="ncm-workbench__activity-tab-group ncm-workbench__collapsible" data-section-key="activity-common.{{key}}" open>
      <summary><strong>{{label}}</strong></summary>
      <div class="ncm-workbench__type-field-grid">{{#each fields}}{{> activityField this common=true}}{{/each}}</div>
    </details>
    {{/each}}
    {{/if}}
  </div>
  {{/if}}
  {{/if}}
  {{/if}}
</div>
{{/inline}}
{{#*inline "activityCompoundNode"}}
  {{#unless isLeaf}}<div class="ncm-workbench__compound-group">{{/unless}}
  {{#if showLabel}}{{#unless isLeaf}}<strong>{{label}}</strong>{{/unless}}{{/if}}
  {{#if isNullable}}<button type="button" data-action="toggleActivityObject" data-complex-address="{{address}}">{{#if isEnabled}}설정 해제{{else}}설정 사용{{/if}}</button>{{/if}}
  {{#if isMapping}}
  <div class="ncm-workbench__compound-list">
    {{#each children}}
    <div class="ncm-workbench__compound-row">
      <div class="ncm-workbench__compound-row-header"><strong>{{mapKey}}</strong><button type="button" data-action="removeActivityMapping" data-complex-address="{{mapAddress}}" data-complex-key="{{mapKey}}">배정 삭제</button></div>
      {{> activityCompoundNode this}}
    </div>
    {{else}}<p class="ncm-workbench__muted">등록된 배정이 없습니다.</p>{{/each}}
    <div class="ncm-workbench__compound-row-header">
      {{#if hasKeyOptions}}<select data-complex-new-key>{{#each keyOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select>{{else}}<input type="text" data-complex-new-key placeholder="{{keyPlaceholder}}">{{/if}}
      <button type="button" data-action="addActivityMapping" data-complex-address="{{address}}">배정 추가</button>
    </div>
  </div>
  {{/if}}
  {{#if isList}}
  <div class="ncm-workbench__compound-list">
    {{#each rows}}
    <div class="ncm-workbench__compound-row">
      <div class="ncm-workbench__compound-row-header"><strong>항목 {{ordinal}}</strong><button type="button" data-action="removeActivityEntry" data-complex-list-address="{{address}}" data-complex-index="{{index}}"><i class="fa-solid fa-trash"></i> 삭제</button></div>
      {{> activityCompoundNode node}}
    </div>
    {{else}}<p class="ncm-workbench__muted">등록된 항목이 없습니다.</p>{{/each}}
    <button type="button" data-action="addActivityEntry" data-complex-list-address="{{address}}"><i class="fa-solid fa-plus"></i> 항목 추가</button>
  </div>
  {{/if}}
  {{#if isObject}}
  <div class="ncm-workbench__compound-grid">
    {{#each children}}{{> activityCompoundNode this}}{{/each}}
  </div>
  {{/if}}
  {{#unless isLeaf}}</div>{{/unless}}
  {{#if isLeaf}}
  <label class="ncm-workbench__type-field">
    <span>{{label}}</span>
    {{#if hasChoices}}
    <select data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}" {{#if refresh}}data-complex-refresh{{/if}}>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    {{else}}
      {{#if isBoolean}}<input type="checkbox" data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}" {{#if refresh}}data-complex-refresh{{/if}} {{#if value}}checked{{/if}}>{{/if}}
      {{#if isNumber}}<input type="number" step="{{step}}" {{#if hasMin}}min="{{min}}"{{/if}} {{#if hasMax}}max="{{max}}"{{/if}} data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}" {{#if refresh}}data-complex-refresh{{/if}} value="{{value}}">{{/if}}
      {{#if isText}}<input type="text" {{#if isReference}}list="{{referenceList}}"{{/if}} data-complex-control data-complex-address="{{address}}" data-complex-kind="{{kind}}" data-complex-baseline="{{baseline}}" {{#if refresh}}data-complex-refresh{{/if}} value="{{value}}" {{#if readOnly}}readonly{{/if}}>{{/if}}
    {{/if}}
    {{#if isReference}}<datalist id="{{referenceList}}">{{#each options}}<option value="{{value}}">{{label}}</option>{{/each}}</datalist><small>목록에서 선택하거나 다른 문서의 참조 값을 입력합니다.</small>{{/if}}
    {{#if help}}<small>{{help}}</small>{{/if}}
  </label>
  {{/if}}
{{/inline}}
{{#*inline "activityField"}}
  {{#if isComplex}}
  <div class="ncm-workbench__type-field is-json" data-activity-complex-root>
    <strong>{{label}}</strong>
    <input type="hidden" {{#if common}}data-activity-common-field data-activity-path="{{path}}"{{else}}data-activity-specific-field data-activity-specific-path="{{path}}"{{/if}} value="{{value}}">
    {{> activityCompoundNode editor}}
  </div>
  {{else}}
  <label class="ncm-workbench__type-field {{#if isJson}}is-json{{/if}} {{#if isLongText}}is-json{{/if}}">
    <span>{{label}}</span>
    {{#if hasChoices}}
    <select {{#if common}}data-activity-common-field data-activity-path="{{path}}"{{else}}data-activity-specific-field data-activity-specific-path="{{path}}"{{/if}}>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    {{else}}
      {{#if isBoolean}}<input type="checkbox" {{#if common}}data-activity-common-field data-activity-path="{{path}}"{{else}}data-activity-specific-field data-activity-specific-path="{{path}}"{{/if}} {{#if value}}checked{{/if}}>{{/if}}
      {{#if isNumber}}<input type="number" step="{{step}}" {{#if hasMin}}min="{{min}}"{{/if}} {{#if common}}data-activity-common-field data-activity-path="{{path}}"{{else}}data-activity-specific-field data-activity-specific-path="{{path}}"{{/if}} value="{{value}}">{{/if}}
      {{#if isText}}{{#if isLongText}}<textarea rows="3" {{#if common}}data-activity-common-field data-activity-path="{{path}}"{{else}}data-activity-specific-field data-activity-specific-path="{{path}}"{{/if}}>{{value}}</textarea>{{else}}<input type="text" {{#if isReference}}list="{{referenceList}}"{{/if}} {{#if common}}data-activity-common-field data-activity-path="{{path}}"{{else}}data-activity-specific-field data-activity-specific-path="{{path}}"{{/if}} value="{{value}}">{{/if}}{{/if}}
      {{#if isJson}}<textarea rows="3" {{#if common}}data-activity-common-field data-activity-path="{{path}}"{{else}}data-activity-specific-field data-activity-specific-path="{{path}}"{{/if}}>{{value}}</textarea>{{/if}}
    {{/if}}
    {{#if isReference}}<datalist id="{{referenceList}}">{{#each options}}<option value="{{value}}">{{label}}</option>{{/each}}</datalist>{{/if}}
  </label>
  {{/if}}
{{/inline}}
{{#*inline "advancementCompoundNode"}}
  {{#if showLabel}}{{#unless isLeaf}}<strong>{{label}}</strong>{{/unless}}{{/if}}
  {{#if isNullable}}<button type="button" data-action="toggleAdvancementObject" data-complex-address="{{address}}">{{#if isEnabled}}설정 해제{{else}}설정 사용{{/if}}</button>{{/if}}
  {{#if isMapping}}
