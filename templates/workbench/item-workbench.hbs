        <summary><strong>식별 정보</strong></summary>

        <label class="ncm-workbench__toggle"><input type="checkbox" name="identified" {{#if selected.identification.identified}}checked{{/if}}> 식별됨</label>
        <div class="ncm-workbench__grid-2">
          <label>미식별 이름<input type="text" name="unidentifiedName" value="{{selected.identification.name}}"></label>
          <label>미식별 설명<textarea name="unidentifiedDescription" rows="3">{{selected.identification.description}}</textarea></label>
        </div>

      </details>
      {{/if}}

      <details class="ncm-workbench__card ncm-workbench__collapsible" data-section-key="quick-effects" open>
        <summary><strong>입력 단축</strong> <span>효과 빠른 추가</span></summary>
        <p class="ncm-workbench__muted">액티비티 작업 영역으로 값을 직접 작성하기 전에 자주 쓰는 효과를 빠르게 시작할 수 있습니다.</p>
        <div class="ncm-workbench__quick-grid">
          <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="quick-effects.damage" open>
            <summary><strong>추가 피해</strong></summary>
            <p class="ncm-workbench__quick-help">현재 선택된 공격·피해·내성 액티비티의 사거리와 대상을 그대로 사용하고 피해만 하나 더 붙입니다.</p>
            {{#if selected.canEditExtraDamage}}
            <div class="ncm-workbench__grid-2">
              <label>피해 주사위식<input type="text" name="quickDamageFormula" placeholder="예: 2d6 + 3"></label>
              <label>피해 유형<select name="quickDamageType">{{#each selected.quickDamageTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
            </div>
            <button type="button" data-action="addQuickDamage"><i class="fa-solid fa-plus"></i> 추가 피해 적용</button>
            {{else}}<p class="ncm-workbench__muted">추가 피해를 적용할 공격·피해·내성 액티비티를 먼저 선택하십시오.</p>{{/if}}
          </details>

          <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="quick-effects.heal" open>
            <summary><strong>회복 효과</strong></summary>
            <p class="ncm-workbench__quick-help">새 회복 액티비티를 만듭니다. 보통 사거리·대상·범위·회복 주사위만 정하면 됩니다.</p>
            <div class="ncm-workbench__grid-2">
              <label>이름<input type="text" name="quickHealName" value="회복 효과"></label>
              <label>회복 주사위식<input type="text" name="quickHealFormula" placeholder="예: 2d8 + 3"></label>
              <label>회복 종류<select name="quickHealType">{{#each selected.quickHealingTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
              <label>사거리 방식<select name="quickHealRangeType">{{#each selected.quickRangeTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
              <label>사거리<input type="text" name="quickHealRangeValue" placeholder="예: 60"></label>
              <label>특수 사거리<input type="text" name="quickHealRangeSpecial" placeholder="특수일 때만 입력"></label>
              <label>대상<select name="quickHealTargetType">{{#each selected.quickTargetTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
              <label>대상 수<input type="text" name="quickHealTargetCount" placeholder="예: 1"></label>
              <label>범위<select name="quickHealAreaType">{{#each selected.quickAreaTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
              <label>범위 크기<input type="text" name="quickHealAreaSize" placeholder="예: 10"></label>
            </div>
            <button type="button" data-action="createQuickActivity" data-purpose="heal"><i class="fa-solid fa-plus"></i> 회복 액티비티 추가</button>
          </details>

          <details class="ncm-workbench__subsection ncm-workbench__collapsible" data-section-key="quick-effects.save" open>
            <summary><strong>내성 공격</strong></summary>
            <p class="ncm-workbench__quick-help">Midi-QOL 내성 공격에 자주 필요한 사거리·대상·범위·피해·내성 난이도·성공 시 처리만 입력합니다.</p>
            <div class="ncm-workbench__grid-2">
              <label>이름<input type="text" name="quickSaveName" value="내성 공격"></label>
              <label>피해 주사위식<input type="text" name="quickSaveFormula" placeholder="예: 7d6"></label>
              <label>피해 유형<select name="quickSaveDamageType">{{#each selected.quickDamageTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
              <label>내성 능력치<select name="quickSaveAbility">{{#each selected.quickAbilityOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
              <label>내성 난이도<input type="text" name="quickSaveDc" placeholder="예: 17"></label>
              <label>내성 성공 시<select name="quickSaveOnSave">{{#each selected.quickOnSaveOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
              <label>사거리 방식<select name="quickSaveRangeType">{{#each selected.quickRangeTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
              <label>사거리<input type="text" name="quickSaveRangeValue" placeholder="예: 150"></label>
              <label>특수 사거리<input type="text" name="quickSaveRangeSpecial" placeholder="특수일 때만 입력"></label>
              <label>대상<select name="quickSaveTargetType">{{#each selected.quickTargetTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
              <label>대상 수<input type="text" name="quickSaveTargetCount" placeholder="비우면 범위 내 대상"></label>
              <label>범위<select name="quickSaveAreaType">{{#each selected.quickAreaTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
              <label>범위 크기<input type="text" name="quickSaveAreaSize" placeholder="예: 15"></label>
            </div>
            <button type="button" data-action="createQuickActivity" data-purpose="save"><i class="fa-solid fa-plus"></i> 내성 액티비티 추가</button>
          </details>

