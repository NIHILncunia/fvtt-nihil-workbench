          <summary><strong>{{label}}</strong></summary>
          <div class="ncm-workbench__type-field-grid">{{#each fields}}{{> typeField this}}{{/each}}</div>
        </details>
        {{/each}}
      </details>
      {{/if}}

      {{#if selected.hasIdentification}}
