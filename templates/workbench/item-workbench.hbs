                  <span class="ncm-workbench__damage-type-label">{{label}}</span>
                </button>
                {{/each}}
              </div>
            </div>
          </div>
          {{else}}<p class="ncm-workbench__muted">이 아이템 유형에는 기본 피해 필드가 없습니다.</p>{{/if}}
        </details>

