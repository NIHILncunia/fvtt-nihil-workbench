            <button type="button" data-action="addContainerItem">넣기</button>
          </div>
          {{/if}}
          <div class="ncm-workbench__container-list">
            {{#each selected.containerManagement.entries}}
            <div class="ncm-workbench__container-row" data-container-row data-item-id="{{id}}" style="--ncm-container-depth: {{depth}}">
              <div class="ncm-workbench__container-row-title">
                {{#if img}}<img src="{{img}}" alt="">{{/if}}
                <button type="button" data-action="openContainerItem" data-item-id="{{id}}">{{#if isContainer}}<i class="fa-solid fa-box"></i> {{/if}}{{name}}</button>
                <small>{{typeLabel}} · {{quantity}}개</small>
