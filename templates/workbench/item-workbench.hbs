              <label>지속 라운드<input type="number" name="quickStatusRounds" min="0" step="1" value="1"></label>
            </div>
            <button type="button" data-action="addQuickStatus"><i class="fa-solid fa-plus"></i> 상태 효과 추가</button>
          </details>
        </div>
      </details>

      <details class="ncm-workbench__card ncm-workbench__collapsible ncm-workbench__guide" data-section-key="activity-guide" open>
