<div class="ncm-document-workbench__layout">
  <header><div class="ncm-workbench__header-actions"><button type="submit" class="ncm-workbench__save" {{#unless canEdit}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> {{submitLabel}}</button></div><h2>{{title}}</h2><p>{{help}}</p></header>
  <div class="ncm-document-workbench__fields">
    {{#each fields}}
    <label><span>{{title}}</span><select name="{{path}}" data-document-path="{{path}}" {{#unless ../canEdit}}disabled{{/unless}}>
      {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select></label>
    {{/each}}
  </div>
</div>
